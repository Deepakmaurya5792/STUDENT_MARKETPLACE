# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/Student_Market_Place?retryWrites=true&w=majority

# JWT secret key for signing tokens
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Frontend URL(s) allowed by CORS (comma-separated if multiple, e.g. https://studentmarket.vercel.app,http://localhost:5173)
CLIENT_URL=http://localhost:5173

# ============================================
# CLOUDINARY MEDIA STORAGE
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
