{
  "name": "student-marketplace",
  "version": "1.0.0",
  "description": "Student Marketplace & Campus Essentials Hub",
  "private": true,
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "build": "npm run build --prefix client",
    "postinstall": "npm install --prefix client && npm install --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "seed:colleges": "node server/seedColleges.js",
    "seed:lostfound": "node server/seedLostFound.js"
  },
  "keywords": [
    "student-marketplace",
    "college",
    "campus-hub",
    "mern",
    "socketio"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
